{
    "name": "ViT-B-32",
    "exp_name": "SAFT",
    "arch": {
        "type": "openclip",
        "args": {
            "model_arch": "ViT-B-32",
            "pretrained_path": "resources/models/foundation/openclip/ViT-B-32-datacomp_xl_s13b_b90k.bin"
        },
        "trainable_layers": [
            "model.visual.transformer",
            "model.visual.ln_post",
            "image_proj.weight"
        ]
    },
    "dataset": {
        "type": "ClipDistillData",
        "args": {
            "train_augmentation": {
                "random_resized_crop": {
                    "scale": [0.8, 1.0],
                    "ratio": [0.1, 1.33]
                },
                "horizontal_flip_probability": 0.5,
                "color_jitter": {
                    "brightness": 0.3,
                    "contrast": 0.3,
                    "saturation": 0.3,
                    "hue": 0
                },
                "gaussian_blur": {
                    "kernel_size": 5,
                    "sigma": [0.1, 2.0],
                    "probability": 0.1
                }
            },
            "train_image_root": [
                "resources/datasets/training/sample/train/images"
            ],
            "train_annotation_files": [
                "resources/datasets/training/sample/train/annotations.txt"
            ],
            "val_image_root": [
                "resources/datasets/training/sample/val/images"
            ],
            "val_annotation_files": [
                "resources/datasets/training/sample/val/annotations.txt"
            ]
        }
    },
    "training": {
        "batch_size": 32,
        "accumulate_grad_batches": 1,
        "max_epochs": 15,
        "val_check_interval": 25,
        "checkpoint_interval_steps": 25
    },
    "optimizer": {
        "type": "AdamW",
        "args": {
            "lr": 5e-06,
            "weight_decay": 0.05,
            "amsgrad": true
        }
    },
    "scheduler": {
        "warmup_ratio": 0.133,
        "min_lr": 5e-07
    },
    "loss": {
        "distillation_temperature": 4,
        "teacher_soft_label_temperature": 0.001,
        "enable_cusa": false,
        "enable_hnm": false,
        "hnm_threshold": 0.0,
        "hnm_top_k": 16
    }
}
